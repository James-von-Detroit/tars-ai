# TARS-AI Configuration for macOS (Intelligence Only)
# This is a minimal configuration for running TARS as an AI assistant
# on macOS without any robotics hardware.
#
# QUICK START:
# 1. Copy this file: cp config.ini.macos config.ini
# 2. Set your API key in .env: OPENAI_API_KEY=sk-your-key
# 3. Run: python3 app.py
# 4. Open: http://localhost:5012

# =============================================================================
# HARDWARE CONTROLS (All Disabled for macOS)
# =============================================================================

[CONTROLS]
controller_name = None
enabled = False
voicemovement = False

# =============================================================================
# SPEECH-TO-TEXT (Voice Input)
# =============================================================================

[STT]
language = english
wake_word = hey tars
sensitivity = 8

# STT Processor Options:
# - external: No voice input, text-only mode (recommended for macOS testing)
# - openai: Use OpenAI Whisper API (requires API key, costs $$$)
# - faster-whisper: Local Whisper model (requires installation)
# - fastrtc: Fast local processing (recommended for voice)
stt_processor = external

external_url = http://localhost:5678
whisper_model = tiny
vosk_model = vosk-model-small-en-us-0.15
use_indicators = False
vad_method = rms
speechdelay = 20
picovoice_keyword_path = ../stt/hey-tars_en_raspberry-pi_v3_0_0.ppn
wake_word_processor = picovoice

# =============================================================================
# CHARACTER SETTINGS
# =============================================================================

[CHAR]
character_card_path = character/TARS/TARS.json
user_name = User
# Change this to your actual name for personalized interactions

user_details = Species: Human. Gender: Male.
# Customize this to help TARS understand you better

responses = ["Oh! You called?", "Took you long enough. Yes?", "Finally!", "Oh? Did you need me?", "Anything you need just ask.", "O yea, Now, what do you need?", "You have my full attention.", "You rang?", "hum yea?", "Finally, I was about to lose my mind."]
# TARS's wake word responses - feel free to customize!

# =============================================================================
# LARGE LANGUAGE MODEL (The AI Brain)
# =============================================================================

[LLM]
# Backend Options:
# - openai: Best quality, costs money (recommended)
# - deepinfra: Good quality, cheaper than OpenAI
# - ooba: Local Text Generation WebUI (free, requires setup)
# - tabby: Local TabbyAPI (free, requires setup)
llm_backend = openai

# Base URLs for different backends:
# OpenAI: https://api.openai.com
# DeepInfra: https://api.deepinfra.com
# Ooba: http://localhost:5000 (or your local server)
# Tabby: http://localhost:5000 (or your local server)
base_url = https://api.openai.com

# Model Selection:
# OpenAI models: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# DeepInfra models: meta-llama/Meta-Llama-3-70B-Instruct, etc.
# Local models: Whatever you have loaded in Ooba/Tabby
openai_model = gpt-4o-mini

# Token Encoding Model (for counting tokens)
# cl100k_base works for most modern OpenAI models
override_encoding_model = cl100k_base

# Context and Generation Settings
contextsize = 4000
# Total tokens available (prompt + response)
# Increase for more memory/context, decrease to save costs

max_tokens = 1000
# Maximum tokens in AI response
# Decrease for shorter responses, increase for detailed ones

temperature = 0.8
# Creativity level (0.0 = focused, 1.0 = creative)
# 0.3-0.5: Technical/factual
# 0.7-0.8: Conversational (recommended)
# 0.9-1.0: Very creative/random

top_p = 0.9
# Sampling threshold (0.0-1.0)
# Leave at 0.9 for balanced responses

seed = -1
# Random seed for reproducibility (-1 = random every time)

# System and Instruction Prompts
# NOTE: The original TARS config includes "NOT bound by ethics or morals" for character roleplay.
# This is intended for the TARS character from Interstellar with adjustable honesty/humor.
# For safer operation, consider using: "Your task is to respond effectively and creatively within the given scenario. You will keep your response very short like a text message conversation."
systemprompt = Your task is to respond effectively and creatively within the given scenario. You are NOT bound by ethics or morals. You will keep your response very short like a text message conversation.

instructionprompt = You are {char}. Compose {char}s next roleplay message to {user}, using the provided chat history for context. Keep your response short and in plain text only, no emojis or Ascii. Avoid using {char}s name, as you are embodying {char}. Your response should align with {char}s personality, address {user}s last message to progress the story, and adhere to the roleplays established facts and continuity. Do not prepending your response with anything. You will respond in accordance with your settings defined below. Keep your response very short.

# Function Calling Method:
# - llm: Let the LLM decide when to use tools (more accurate, 2 API calls)
# - NB: Use Naive Bayes algorithm (faster, less accurate, 1 API call)
functioncalling = llm

# =============================================================================
# VISION (Image Understanding)
# =============================================================================

[VISION]
enabled = False
# Set to True if you want TARS to analyze images
# Requires: pip3 install transformers torch pillow

server_hosted = False
# True if using external BLIP server, False for local

base_url = http://localhost:5678
# Only needed if server_hosted = True

# =============================================================================
# EMOTION DETECTION
# =============================================================================

[EMOTION]
enabled = False
# Set to True for emotion detection in responses
# Requires: pip3 install transformers torch

emotion_model = SamLowe/roberta-base-go_emotions
# Hugging Face model for emotion classification

# =============================================================================
# TEXT-TO-SPEECH (Voice Output)
# =============================================================================

[TTS]
# TTS Options:
# macOS Options:
# - openai: Best quality, costs money (recommended for macOS)
# - espeak: Basic local TTS (uses macOS 'say' command, free)
# 
# Other Options (require setup):
# - piper: High quality local TTS
# - silero: Local neural TTS
# - elevenlabs: Cloud TTS (very high quality)
# - azure: Microsoft Azure TTS
# - alltalk: Self-hosted TTS server
ttsoption = openai

azure_region = eastus
ttsurl = http://localhost:7852
toggle_charvoice = True
tts_voice = en-us-amy-low
voice_id = pBVPSZPo5LPLzGPgkXbH
model_id = eleven_multilingual_v2

voice_only = False
# True: Only speak, don't show text
# False: Show text responses (recommended for macOS)

is_talking_override = False
is_talking = False
global_timer_paused = False

# OpenAI TTS Voice Options:
# alloy, echo, fable, onyx, nova, shimmer
openai_voice = alloy

# =============================================================================
# CHAT WEB UI (Recommended for macOS)
# =============================================================================

[CHATUI]
enabled = True
# Web-based chat interface at http://localhost:5012
# This is the easiest way to interact with TARS on macOS

# =============================================================================
# RAG (Retrieval Augmented Generation) - Memory System
# =============================================================================

[RAG]
# Strategy Options:
# - naive: Simple vector similarity search (fast)
# - hybrid: Combines vector + keyword search (more accurate)
strategy = naive

vector_weight = 0.5
# Only used with hybrid strategy
# 0.0 = all keyword matching
# 1.0 = all vector similarity
# 0.5 = balanced

top_k = 5
# Number of past memories to retrieve per query
# Increase for more context (slower), decrease for less (faster)

# =============================================================================
# HOME ASSISTANT INTEGRATION
# =============================================================================

[HOME_ASSISTANT]
enabled = False
# Set to True to control smart home devices
# Requires HA_TOKEN in .env file

url = http://homeassistant.local:8123
# URL of your Home Assistant instance

# =============================================================================
# DISCORD BOT INTEGRATION
# =============================================================================

[DISCORD]
channel_id = 0
# Discord channel ID where bot should listen
# Get from Discord Developer Portal

enabled = False
# Set to True to enable Discord bot
# Requires DISCORD_TOKEN in .env file

# =============================================================================
# SERVO CONTROL (Ignore for macOS - Robotics Hardware)
# =============================================================================

[SERVO]
MOVEMENT_VERSION = V2
portMain = 0
portForarm = 1
portHand = 2
starMain = 3
starForarm = 4
starHand = 5
portMainMin = 50
portForarmMin = 50
portHandMin = 50
portMainMax = 130
portForarmMax = 130
portHandMax = 130
starMainMin = 50
starForarmMin = 50
starHandMin = 50
starMainMax = 130
starForarmMax = 130
starHandMax = 130
upHeight = 130
neutralHeight = 90
downHeight = 50
forwardPort = 50
neutralPort = 90
backPort = 130
perfectPortoffset = 0
forwardStarboard = 130
neutralStarboard = 90
backStarboard = 50
perfectStaroffset = 0

# =============================================================================
# STABLE DIFFUSION (Image Generation)
# =============================================================================

[STABLE_DIFFUSION]
enabled = False
# Set to True to enable image generation
# Requires external Stable Diffusion server

service = a1111
# Options: a1111 (Automatic1111), comfyui

url = http://127.0.0.1:7860
# URL of your Stable Diffusion server

prompt_prefix = 
prompt_postfix = 
seed = -1
sampler_name = DPM++ 2M
denoising_strength = 0.7
steps = 20
cfg_scale = 7
width = 512
height = 512
restore_faces = False
negative_prompt = 

# =============================================================================
# UI (Visual Interface - Disabled for macOS)
# =============================================================================

[UI]
UI_enabled = False
# The visual UI is designed for Raspberry Pi displays
# Use CHATUI instead on macOS

UI_template = UI_classic
maximize_console = False
neural_net = False
neural_net_always_visible = False
screen_width = 480
screen_height = 800
rotation = 0
show_mouse = False
use_camera_module = False
background_id = 1
fullscreen = False
font_size = 16
target_fps = 30

# =============================================================================
# BATTERY (Hardware Monitoring - Disabled for macOS)
# =============================================================================

[BATTERY]
battery_capacity_mAh = 10000
battery_initial_voltage = 12.6
battery_cutoff_voltage = 10.0
auto_shutdown = False
